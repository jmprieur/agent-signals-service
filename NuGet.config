<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Aspire 17 preview daily builds. The Entra ID hosting integration (Aspire.Hosting.Azure.EntraId)
         is not on nuget.org yet. Remove this feed once Aspire 17 ships. -->
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>